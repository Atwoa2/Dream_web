# ============================================================================
#  ШАБЛОН ПЕРЕМЕННЫХ ОКРУЖЕНИЯ
# ----------------------------------------------------------------------------
#  Это ТОЛЬКО список имён. Реальные значения сюда НЕ вписываем и НЕ коммитим.
#
#  Как пользоваться:
#    1. cp .env.example .env.local
#    2. заполнить значения (взять в общем менеджере паролей команды)
#    3. .env.local уже в .gitignore — он никогда не попадёт в репозиторий
#
#  Боевые ключи (sk_live_, прод-база) живут ТОЛЬКО в Vercel Environment
#  Variables и НЕ выдаются разработчикам.
# ============================================================================

# --- Приложение -------------------------------------------------------------
# Публичный адрес приложения. Локально — http://localhost:3000
APP_URL="http://localhost:3000"

# Окружение: development | preview | production
APP_ENV="development"

# --- База данных ------------------------------------------------------------
# Строка подключения PostgreSQL.
# Локально (Docker):  postgresql://postgres:postgres@localhost:5432/dreamlabs
# Neon:               postgresql://user:pass@ep-xxx.neon.tech/db?sslmode=require
DATABASE_URL=""

# --- Аутентификация (этап 1) ------------------------------------------------
# Секрет для подписи сессий. Сгенерировать своим, уникальным для каждого окружения:
#   openssl rand -base64 32
AUTH_SECRET=""

# Google OAuth. Создаётся в Google Cloud Console → APIs & Services → Credentials.
# Redirect URI: {APP_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Отправка писем (этап 1) ------------------------------------------------
# Resend — для писем с кодом подтверждения.
RESEND_API_KEY=""
EMAIL_FROM="noreply@example.com"

# --- Stripe (этап 3) --------------------------------------------------------
# Test-ключи из Stripe Dashboard → Developers → API keys.
# ВНИМАНИЕ: sk_live_ здесь быть не должно ни при каких обстоятельствах.
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Webhook-секрет. У КАЖДОГО РАЗРАБОТЧИКА СВОЙ — его выдаёт команда:
#   stripe listen --forward-to localhost:3000/api/stripe/webhook
# Значение из общего конфига сюда не подходит.
STRIPE_WEBHOOK_SECRET=""

# Идентификаторы цен из Stripe. В test и live они РАЗНЫЕ, поэтому в код
# не зашиваются никогда.
STRIPE_PRICE_SUBSCRIPTION=""
STRIPE_PRICE_CREDITS_PACK=""

# --- Rate limiting (этап 1) -------------------------------------------------
# Upstash Redis — лимиты на отправку кода, вход и вызовы API.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
