# ============================================================================
#  ENVIRONMENT VARIABLE TEMPLATE
# ----------------------------------------------------------------------------
#  This file lists variable NAMES only. Real values are never written here
#  and never committed.
#
#  Usage:
#    1. cp .env.example .env.local
#    2. fill in the values (find them in the team password manager)
#    3. .env.local is already in .gitignore — it never reaches the repository
#
#  Production keys (sk_live_, production DB) live ONLY in Vercel Environment
#  Variables and are not handed out to developers.
# ============================================================================

# --- Application ------------------------------------------------------------
# Public application URL. Locally: http://localhost:3000
APP_URL="http://localhost:3000"

# Environment: development | preview | production
APP_ENV="development"

# --- Authentication (stage 1) -----------------------------------------------
# Secret for signing. Generate a unique one per environment:
#   openssl rand -base64 32
AUTH_SECRET=""

# Google OAuth. Created in Google Cloud Console → APIs & Services → Credentials.
# Redirect URI: {APP_URL}/api/auth/google/callback
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Email (stage 1) --------------------------------------------------------
# Resend — verification code emails.
RESEND_API_KEY=""
EMAIL_FROM="noreply@example.com"

# --- Stripe (stage 3) -------------------------------------------------------
# Test keys from Stripe Dashboard → Developers → API keys.
# WARNING: sk_live_ must never appear here under any circumstances.
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Webhook secret. EVERY DEVELOPER HAS THEIR OWN — issued by:
#   stripe listen --forward-to localhost:3000/api/stripe/webhook
# A value from a shared config will not work here.
STRIPE_WEBHOOK_SECRET=""

# Stripe price identifiers. They DIFFER between test and live mode, which is
# why they are never hard-coded.
STRIPE_PRICE_SUBSCRIPTION=""
STRIPE_PRICE_CREDITS_PACK=""

# --- Robot backend proxy ----------------------------------------------------
# The Dream Labs robot backend (/v1/*). The gate token is SERVER-ONLY here —
# unlike the legacy SPA, it must never be exposed to the browser.
DREAM_API_URL=""
DREAM_API_TOKEN=""

# --- Firebase (data store) --------------------------------------------------
# Base64 of the service-account JSON (Firebase Console → Project settings →
# Service accounts → Generate new private key). SERVER-ONLY — this is a full
# admin credential; the browser API key is not used at all.
#   PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("key.json"))
FIREBASE_SERVICE_ACCOUNT=""
